{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "DatabaseSettings": {
    "Identity": "",
    "FullService": ""
  },

  "IdentitySettings": {
